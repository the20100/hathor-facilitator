# Hathor x402 Facilitator Configuration

# Server Configuration
PORT=8443

# Hathor Node Configuration
# Full node HTTP API URL
HATHOR_NODE_URL=http://localhost:8080

# Hathor Headless Wallet Configuration
# Wallet service URL
HATHOR_WALLET_URL=http://localhost:8000

# Wallet ID for the headless wallet
HATHOR_WALLET_ID=merchant-wallet

# Settlement Configuration
# Minimum number of block confirmations required before returning success
# For low-value transactions, 1 confirmation (~30s) is usually sufficient
# For higher security, use 6 confirmations (~3 minutes)
MIN_CONFIRMATIONS=1
